      "source": [
        "# ==========================================================\n",
        "# Graded Lab 1: Python Basics (all in one cell)\n",
        "# Name   : YOUR NAME HERE\n",
        "# GitHub : https://github.com/YOUR-USERNAME\n",
        "# ==========================================================\n",
        "\n",
        "def section(title):\n",
        "    print(\"\\n\" + \"=\" * 50)\n",
        "    print(title)\n",
        "    print(\"=\" * 50)\n",
        "\n",
        "print(\"Graded Lab 1: Python Basics\")\n",
        "print(\"Name   : YOUR NAME HERE\")\n",
        "print(\"GitHub : https://github.com/YOUR-USERNAME\")\n",
        "\n",
        "# ---------------- 1. Variables and Data Types ----------------\n",
        "section(\"1. Variables and Data Types\")\n",
        "name = \"Ali\"          # str\n",
        "age = 20              # int\n",
        "height = 5.9          # float\n",
        "is_student = True     # bool\n",
        "nothing = None        # NoneType\n",
        "\n",
        "for value in (name, age, height, is_student, nothing):\n",
        "    print(value, \"->\", type(value).__name__)\n",
        "\n",
        "# Type conversion\n",
        "print(int(\"42\") + 8)\n",
        "print(float(3) / 2)\n",
        "print(str(100) + \" marks\")\n",
        "print(bool(0), bool(\"hello\"))\n",
        "\n",
        "# ---------------- 2. Input, Output and f-strings ----------------\n",
        "section(\"2. Input, Output and f-strings\")\n",
        "# input() waits for the user, so it is commented out to let the cell run top to bottom\n",
        "# user_name = input(\"Enter your name: \")\n",
        "user_name = \"Sara\"   # simulated input\n",
        "\n",
        "print(\"Hello,\", user_name)\n",
        "print(f\"Hello, {user_name}! Next year you will be {age + 1}.\")\n",
        "print(f\"Height: {height:.2f} ft\")\n",
        "print(\"a\", \"b\", \"c\", sep=\"-\", end=\"!\\n\")\n",
        "\n",
        "# ---------------- 3. Operators ----------------\n",
        "section(\"3. Operators\")\n",
        "a, b = 17, 5\n",
        "\n",
        "print(\"Arithmetic:\", a + b, a - b, a * b, a / b, a // b, a % b, a ** 2)\n",
        "print(\"Comparison:\", a > b, a == b, a != b, a <= b)\n",
        "print(\"Logical:\", (a > 10) and (b < 10), (a < 10) or (b < 10), not (a > b))\n",
        "\n",
        "x = 10\n",
        "x += 5\n",
        "x *= 2\n",
        "print(\"Assignment operators:\", x)\n",
        "\n",
        "print(\"Membership:\", \"py\" in \"python\", 3 in [1, 2, 3])\n",
        "print(\"Identity:\", a is b, a is not b)\n",
        "\n",
        "# ---------------- 4. Conditional Statements ----------------\n",
        "section(\"4. Conditional Statements\")\n",
        "def grade(marks):\n",
        "    if marks >= 90:\n",
        "        return \"A\"\n",
        "    elif marks >= 80:\n",
        "        return \"B\"\n",
        "    elif marks >= 70:\n",
        "        return \"C\"\n",
        "    elif marks >= 60:\n",
        "        return \"D\"\n",
        "    else:\n",
        "        return \"F\"\n",
        "\n",
        "for m in (95, 83, 71, 64, 40):\n",
        "    print(m, \"->\", grade(m))\n",
        "\n",
        "# Ternary expression\n",
        "num = 7\n",
        "print(num, \"is\", \"even\" if num % 2 == 0 else \"odd\")\n",
        "\n",
        "# ---------------- 5. Loops ----------------\n",
        "section(\"5. Loops\")\n",
        "# for loop with range\n",
        "for i in range(1, 6):\n",
        "    print(i, end=\" \")\n",
        "print()\n",
        "\n",
        "# looping over a string\n",
        "for ch in \"Python\":\n",
        "    print(ch, end=\" \")\n",
        "print()\n",
        "\n",
        "# while loop\n",
        "count = 3\n",
        "while count > 0:\n",
        "    print(\"Countdown:\", count)\n",
        "    count -= 1\n",
        "\n",
        "# break, continue and enumerate\n",
        "for index, n in enumerate(range(10)):\n",
        "    if n == 2:\n",
        "        continue      # skip 2\n",
        "    if n == 6:\n",
        "        break         # stop at 6\n",
        "    print(index, n)\n",
        "\n",
        "# multiplication table\n",
        "for i in range(1, 6):\n",
        "    print(f\"5 x {i} = {5 * i}\")\n",
        "\n",
        "# ---------------- 6. Lists ----------------\n",
        "section(\"6. Lists\")\n",
        "fruits = [\"apple\", \"banana\", \"cherry\"]\n",
        "fruits.append(\"mango\")\n",
        "fruits.insert(1, \"orange\")\n",
        "fruits.remove(\"banana\")\n",
        "print(fruits)\n",
        "\n",
        "print(\"First:\", fruits[0], \"| Last:\", fruits[-1])\n",
        "print(\"Slice [1:3]:\", fruits[1:3])\n",
        "print(\"Length:\", len(fruits))\n",
        "\n",
        "numbers = [5, 2, 9, 1, 7]\n",
        "numbers.sort()\n",
        "print(\"Sorted:\", numbers)\n",
        "print(\"Reversed:\", numbers[::-1])\n",
        "print(\"Min/Max/Sum:\", min(numbers), max(numbers), sum(numbers))\n",
        "print(\"Popped:\", numbers.pop(), \"->\", numbers)\n",
        "\n",
        "# ---------------- 7. Tuples and Sets ----------------\n",
        "section(\"7. Tuples and Sets\")\n",
        "# Tuple: ordered and immutable\n",
        "point = (3, 4)\n",
        "x, y = point            # unpacking\n",
        "print(\"Tuple:\", point, \"| x =\", x, \"| y =\", y)\n",
        "\n",
        "# Set: unordered and unique\n",
        "s1 = {1, 2, 3, 4}\n",
        "s2 = {3, 4, 5, 6}\n",
        "print(\"Union:\", s1 | s2)\n",
        "print(\"Intersection:\", s1 & s2)\n",
        "print(\"Difference:\", s1 - s2)\n",
        "\n",
        "duplicates = [1, 2, 2, 3, 3, 3]\n",
        "print(\"Unique values:\", set(duplicates))\n",
        "\n",
        "# ---------------- 8. Dictionaries ----------------\n",
        "section(\"8. Dictionaries\")\n",
        "student = {\"name\": \"Ali\", \"age\": 20, \"course\": \"Python\"}\n",
        "student[\"grade\"] = \"A\"\n",
        "student[\"age\"] = 21\n",
        "print(student)\n",
        "\n",
        "print(\"Name:\", student[\"name\"])\n",
        "print(\"City:\", student.get(\"city\", \"Not given\"))\n",
        "\n",
        "for key, value in student.items():\n",
        "    print(f\"{key}: {value}\")\n",
        "\n",
        "print(\"Keys:\", list(student.keys()))\n",
        "print(\"Values:\", list(student.values()))\n",
        "\n",
        "del student[\"grade\"]\n",
        "print(\"After delete:\", student)\n",
        "\n",
        "# Nested dictionary\n",
        "classroom = {\"s1\": {\"name\": \"Ali\", \"marks\": 85}, \"s2\": {\"name\": \"Sara\", \"marks\": 92}}\n",
        "print(classroom[\"s2\"][\"name\"], classroom[\"s2\"][\"marks\"])\n",
        "\n",
        "# ---------------- 9. String Methods ----------------\n",
        "section(\"9. String Methods\")\n",
        "text = \"  Hello, Python World!  \"\n",
        "\n",
        "print(text.strip())\n",
        "print(text.lower())\n",
        "print(text.upper())\n",
        "print(text.strip().replace(\"World\", \"Colab\"))\n",
        "print(text.strip().split(\",\"))\n",
        "print(\" - \".join([\"a\", \"b\", \"c\"]))\n",
        "print(\"python\".capitalize(), \"|\", \"hello world\".title())\n",
        "print(\"Python\".startswith(\"Py\"), \"Python\".endswith(\"on\"))\n",
        "print(\"banana\".count(\"a\"), \"banana\".find(\"n\"))\n",
        "\n",
        "word = \"level\"\n",
        "print(word, \"is a palindrome:\", word == word[::-1])\n",
        "\n",
        "# ---------------- 10. Functions ----------------\n",
        "section(\"10. Functions\")\n",
        "def greet(name, greeting=\"Hello\"):\n",
        "    \"\"\"Return a greeting (default argument example).\"\"\"\n",
        "    return f\"{greeting}, {name}!\"\n",
        "\n",
        "print(greet(\"Ali\"))\n",
        "print(greet(\"Sara\", \"Good morning\"))\n",
        "\n",
        "def add_all(*numbers):\n",
        "    \"\"\"*args: any number of positional arguments.\"\"\"\n",
        "    return sum(numbers)\n",
        "\n",
        "print(add_all(1, 2, 3, 4, 5))\n",
        "\n",
        "def show_info(**details):\n",
        "    \"\"\"**kwargs: any number of keyword arguments.\"\"\"\n",
        "    for k, v in details.items():\n",
        "        print(f\"{k} = {v}\")\n",
        "\n",
        "show_info(name=\"Ali\", city=\"Islamabad\")\n",
        "\n",
        "def factorial(n):\n",
        "    return 1 if n <= 1 else n * factorial(n - 1)\n",
        "\n",
        "print(\"5! =\", factorial(5))\n",
        "\n",
        "# Lambda, map and filter\n",
        "square = lambda n: n ** 2\n",
        "print(square(6))\n",
        "print(list(map(square, [1, 2, 3, 4])))\n",
        "print(list(filter(lambda n: n % 2 == 0, range(10))))\n",
        "\n",
        "# ---------------- 11. List Comprehensions ----------------\n",
        "section(\"11. List Comprehensions\")\n",
        "squares = [n ** 2 for n in range(1, 8)]\n",
        "evens = [n for n in range(20) if n % 2 == 0]\n",
        "words = [\"python\", \"colab\", \"github\"]\n",
        "upper_words = [w.upper() for w in words]\n",
        "square_dict = {n: n ** 2 for n in range(1, 5)}\n",
        "\n",
        "print(squares)\n",
        "print(evens)\n",
        "print(upper_words)\n",
        "print(square_dict)\n",
        "\n",
        "# ---------------- 12. Error Handling ----------------\n",
        "section(\"12. Error Handling\")\n",
        "def safe_divide(a, b):\n",
        "    try:\n",
        "        result = a / b\n",
        "    except ZeroDivisionError:\n",
        "        return \"Cannot divide by zero\"\n",
        "    except TypeError:\n",
        "        return \"Please pass numbers only\"\n",
        "    else:\n",
        "        return result\n",
        "    finally:\n",
        "        print(\"(division attempted)\")\n",
        "\n",
        "print(safe_divide(10, 2))\n",
        "print(safe_divide(10, 0))\n",
        "print(safe_divide(10, \"a\"))\n",
        "\n",
        "try:\n",
        "    int(\"abc\")\n",
        "except ValueError as e:\n",
        "    print(\"ValueError caught:\", e)\n",
        "\n",
        "# ---------------- 13. File Handling ----------------\n",
        "section(\"13. File Handling\")\n",
        "# Write\n",
        "with open(\"sample.txt\", \"w\") as f:\n",
        "    f.write(\"Line 1: Hello from Python\\n\")\n",
        "    f.write(\"Line 2: File handling works\\n\")\n",
        "\n",
        "# Append\n",
        "with open(\"sample.txt\", \"a\") as f:\n",
        "    f.write(\"Line 3: Appended text\\n\")\n",
        "\n",
        "# Read\n",
        "with open(\"sample.txt\", \"r\") as f:\n",
        "    content = f.read()\n",
        "print(content)\n",
        "\n",
        "# Read line by line\n",
        "with open(\"sample.txt\") as f:\n",
        "    for number, line in enumerate(f, start=1):\n",
        "        print(number, line.strip())\n",
        "\n",
        "# ---------------- 14. Classes and Objects ----------------\n",
        "section(\"14. Classes and Objects (OOP Basics)\")\n",
        "class Student:\n",
        "    school = \"Python Academy\"          # class attribute\n",
        "\n",
        "    def __init__(self, name, marks):\n",
        "        self.name = name               # instance attributes\n",
        "        self.marks = marks\n",
        "\n",
        "    def is_passing(self):\n",
        "        return self.marks >= 50\n",
        "\n",
        "    def __str__(self):\n",
        "        return f\"Student({self.name}, {self.marks})\"\n",
        "\n",
        "class GradStudent(Student):            # inheritance\n",
        "    def __init__(self, name, marks, thesis):\n",
        "        super().__init__(name, marks)\n",
        "        self.thesis = thesis\n",
        "\n",
        "s1 = Student(\"Ali\", 78)\n",
        "s2 = GradStudent(\"Sara\", 91, \"Machine Learning\")\n",
        "print(s1, \"| passing:\", s1.is_passing())\n",
        "print(s2, \"| thesis:\", s2.thesis, \"| school:\", s2.school)\n",
        "\n",
        "# ---------------- 15. Modules and Libraries ----------------\n",
        "section(\"15. Modules and Libraries\")\n",
        "import math\n",
        "import random\n",
        "from datetime import datetime\n",
        "\n",
        "print(\"sqrt(144) =\", math.sqrt(144))\n",
        "print(\"pi =\", round(math.pi, 4))\n",
        "print(\"ceil/floor:\", math.ceil(4.2), math.floor(4.8))\n",
        "\n",
        "random.seed(1)\n",
        "print(\"Random int:\", random.randint(1, 100))\n",
        "print(\"Random choice:\", random.choice([\"red\", \"green\", \"blue\"]))\n",
        "\n",
        "print(\"Today:\", datetime.now().strftime(\"%d %B %Y\"))\n",
        "\n",
        "# ---------------- 16. Mini Programs ----------------\n",
        "section(\"16. Mini Programs\")\n",
        "# 1. FizzBuzz\n",
        "for i in range(1, 16):\n",
        "    if i % 15 == 0:\n",
        "        print(\"FizzBuzz\")\n",
        "    elif i % 3 == 0:\n",
        "        print(\"Fizz\")\n",
        "    elif i % 5 == 0:\n",
        "        print(\"Buzz\")\n",
        "    else:\n",
        "        print(i)\n",
        "\n",
        "# 2. Prime number check\n",
        "def is_prime(n):\n",
        "    if n < 2:\n",
        "        return False\n",
        "    for i in range(2, int(n ** 0.5) + 1):\n",
        "        if n % i == 0:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "print([n for n in range(1, 30) if is_prime(n)])\n",
        "\n",
        "# 3. Word frequency counter\n",
        "sentence = \"the quick brown fox jumps over the lazy dog the end\"\n",
        "freq = {}\n",
        "for w in sentence.split():\n",
        "    freq[w] = freq.get(w, 0) + 1\n",
        "print(freq)\n",
        "\n",
        "print(\"\\nGitHub: https://github.com/Taimoor312\")"
      ]
    }
  ]
}