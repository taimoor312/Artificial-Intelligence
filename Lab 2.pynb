    {
      "cell_type": "code",
      "source": [
        "def print_solution(start, path):\n",
        "    state = start\n",
        "    print(\"Initial state:\")\n",
        "    show(state)\n",
        "    for step, a in enumerate(path, 1):\n",
        "        state = result(state, a)\n",
        "        print(f\"\\nStep {step}: move blank {a}\")\n",
        "        show(state)\n",
        "    print(\"\\nGoal reached!\" if goal_test(state) else \"\\nGoal NOT reached\")\n",
        "\n",
        "print_solution(start1, path1)"
      ],
      "metadata": {
