    {
      "cell_type": "code",
      "source": [
        "import random\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "OPPOSITE = {'Up': 'Down', 'Down': 'Up', 'Left': 'Right', 'Right': 'Left'}\n",
        "\n",
        "def scramble(k):\n",
        "    state, prev = GOAL, None\n",
        "    for _ in range(k):\n",
        "        options = [a for a in actions(state) if a != OPPOSITE.get(prev)]\n",
        "        prev = random.choice(options)\n",
        "        state = result(state, prev)\n",
        "    return state\n",
        "\n",
        "random.seed(42)\n",
        "rows = []\n",
        "for k in (5, 10, 15, 20, 25):\n",
        "    s = scramble(k)\n",
        "    t0 = time.perf_counter()\n",
        "    path, expanded, generated = solve_bfs(s)\n",
        "    ms = (time.perf_counter() - t0) * 1000\n",
        "    rows.append((k, len(path), expanded, generated, ms))\n",
        "\n",
        "print(\"Random moves | Depth | Expanded | Generated | Time (ms)\")\n",
        "for k, depth, expanded, generated, ms in rows:\n",
        "    print(f\"{k:>12} | {depth:>5} | {expanded:>8} | {generated:>9} | {ms:>9.2f}\")\n",
        "\n",
        "rows.sort(key=lambda r: r[1])\n",
        "depths = [r[1] for r in rows]\n",
        "exp_list = [r[2] for r in rows]\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.plot(depths, exp_list, marker=\"o\")\n",
        "plt.yscale(\"log\")\n",
        "plt.xlabel(\"Solution depth (moves)\")\n",
        "plt.ylabel(\"Nodes expanded (log scale)\")\n",
        "plt.title(\"BFS on the 8-puzzle: depth vs nodes expanded\")\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()"
      ],
