    {
      "cell_type": "markdown",
      "source": [
        "Nodes expanded grow exponentially with depth. Each extra move multiplies the work by about 2, so the log plot is close to a straight line. BFS explores every shallower node first, so it becomes slow for deep puzzles.\n"
      ],
      "metadata": {
        "id": "YiIEqCgMd1P6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def count_inversions(state):\n",
        "    tiles = [t for t in state if t != 0]\n",
        "    return sum(1 for a in range(len(tiles))\n",
        "                 for b in range(a + 1, len(tiles)) if tiles[a] > tiles[b])\n",
        "\n",
        "def solve_puzzle(start):\n",
        "    if not is_solvable(start):\n",
        "        print(\"Start state:\"); show(start)\n",
        "        print(\"Inversions:\", count_inversions(start), \"(odd)\")\n",
        "        print(\"This puzzle is UNSOLVABLE. Search not started.\")\n",
        "        return None\n",
        "    path, expanded, generated = solve_bfs(start)\n",
        "    return path\n",
        "\n",
        "print(solve_puzzle((1, 2, 3, 4, 5, 6, 8, 7, 0)))"
      ],
      "metadata": {
